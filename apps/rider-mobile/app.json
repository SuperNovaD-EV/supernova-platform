{
  "expo": {
    "name": "SuperNova Rider",
    "slug": "supernova-rider",
    "owner": "omar-gouda",
    "scheme": "supernova-rider",
    "orientation": "portrait",
    "icon": "./assets/brand/supernova-app-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/supernova-splash.png",
          "backgroundColor": "#0D1117",
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.supernovamobility.rider"
    },
    "android": {
      "package": "com.supernovamobility.rider"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bb4cf74b-cb81-4200-9415-7821f5dea5be"
      }
    }
  }
}
