{
  "expo": {
    "name": "SuperNova Rider",
    "slug": "supernova-rider",
    "scheme": "supernova-rider",
    "orientation": "portrait",
    "icon": "./assets/brand/supernova-app-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/supernova-splash.png",
          "backgroundColor": "#0D1117",
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": { "bundleIdentifier": "com.example.supernova.rider" },
    "android": { "package": "com.example.supernova.rider" },
    "extra": { "router": { "origin": false } }
  }
}
